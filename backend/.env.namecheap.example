# =====================================================================
# TersooPilot Namecheap cPanel Production Environment Configuration
# Subdomain: tersoopilotbd.tersoo.name.ng
# =====================================================================

# 1. SECURITY & HOSTS
SECRET_KEY=tersoopilot-secret-key-change-this-in-production-random-98124
DEBUG=False
ALLOWED_HOSTS=tersoopilotbd.tersoo.name.ng,tersoopilot.tersoo.name.ng,tersoo.name.ng,127.0.0.1,localhost

# 2. MYSQL DATABASE CONFIGURATION (Namecheap cPanel MySQL)
# In cPanel -> "MySQL Databases":
# 1. Create database (e.g. yourcpaneluser_terso)
# 2. Create user (e.g. yourcpaneluser_dbuser) with strong password
# 3. Add user to database with ALL PRIVILEGES
DB_ENGINE=mysql
MYSQL_DATABASE=yourcpaneluser_terso
MYSQL_USER=yourcpaneluser_dbuser
MYSQL_PASSWORD=YourDatabasePasswordHere
MYSQL_HOST=localhost
MYSQL_PORT=3306

# 3. CORS & CSRF TRUSTED DOMAINS
CORS_ALLOWED_ORIGINS=https://tersoopilot.tersoo.name.ng,http://tersoopilot.tersoo.name.ng
CSRF_TRUSTED_ORIGINS=https://tersoopilot.tersoo.name.ng,https://tersoopilotbd.tersoo.name.ng

# 4. OPTIONAL AI MODEL KEYS
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 5. TOKEN LIFETIME (Hours, default 72 hours)
TOKEN_EXPIRY_HOURS=72
